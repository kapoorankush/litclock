#!/bin/sh
# NetworkManager dispatcher: re-render the LitClock e-ink when wlan0's
# IP changes, so the corner QR stops advertising a stale address after
# DHCP churn (router reboot, WiFi reconnect, lease expiry). Fixes the
# UX side of litclock-dev#309.
#
# The RE-RENDER is gated on /etc/litclock/.handoff-complete so it does
# NOT fire during first-boot hotspot teardown — during setup,
# litclock.service isn't running yet and there's nothing to repaint.
# The bookkeeping above that gate (the collected marker and the
# last-rendered-ip file) is deliberately NOT gated: see litclock-dev#645.
#
# Events for our OWN setup hotspot are dropped entirely, above both —
# see the guard below.
#
# Install: scripts/update.sh (Phase 5c) and
# pi-gen/stage3/03-install-services/00-run.sh copy this file to
# /etc/NetworkManager/dispatcher.d/99-litclock-ip-change with mode
# 0755 root:root. Do not edit the installed copy — edit the source in
# the repo and re-run update.sh.
#
# Runtime dependency (litclock-dev#387 C1): this dispatcher runs as ROOT and invokes the
# ROOT-OWNED /usr/local/lib/litclock/litclock-mark-collected.sh, installed by
# the same three sites. Never wire it back to a pi-writable path.

set -eu

INTERFACE="${1:-}"
ACTION="${2:-}"

# Our own setup access point, as created by src/wifi_provision.py. These MUST
# stay in lockstep with HOTSPOT_CON_NAME / HOTSPOT_GATEWAY there (and with
# HOTSPOT_GATEWAY_IP in src/setup_server.py); a shell script cannot import
# them, so tests/test_nm_dispatcher_behavior.py asserts the parity instead.
HOTSPOT_CON_NAME=litclock-hotspot
HOTSPOT_GATEWAY=10.42.0.1

# Only react to events on the WiFi interface. The Pi Zero 2W stock
# image only ever brings up wlan0; this filter also keeps us safe if
# the user later adds USB ethernet or a USB-WiFi dongle that grabs a
# different name and shouldn't trigger our re-render.
[ "$INTERFACE" = "wlan0" ] || exit 0

case "$ACTION" in
    up|dhcp4-change|dhcp6-change) ;;
    *) exit 0 ;;
esac

CURRENT_IP=$(ip -4 -o addr show wlan0 2>/dev/null | awk 'NR==1{split($4,a,"/"); print a[1]}' || true)

# Ignore our own setup hotspot (litclock-dev#645 /review). During first-boot, wlan0
# carries the hotspot's static 10.42.0.1 and NM fires `up` for it on the same
# interface — so with the handoff gate moved down, that address would be
# recorded as the clock's LAN IP. That is worse than the bug being fixed:
# _anomalies.py only tests lan_ip for truthiness, so a device that NEVER
# acquired a real address would report a healthy network on the strength of
# its own hotspot. Marking the Network section "collected" here would mute the
# grey Not-yet-collected tier on the same false premise.
#
# CONNECTION_ID is set by NM for the events we handle; the address comparison
# is the backstop for anything that reaches here without it.
if [ "${CONNECTION_ID:-}" = "$HOTSPOT_CON_NAME" ] || [ "${CURRENT_IP:-}" = "$HOTSPOT_GATEWAY" ]; then
    exit 0
fi

# Treat a non-routable address as no address at all (litclock-dev#645 /review). If DHCP
# fails on the owner's network, NM self-assigns a 169.254.x link-local — and
# _anomalies.py:134 only tests lan_ip for truthiness, so recording that string
# would suppress the missing-IP anomaly forever, on the very fresh-provision
# path this fix targets. That inverts the change: a clock that never got a
# lease would report itself healthy where it previously (correctly) tripped at
# 300s. Blanking rather than exiting is deliberate — this IS a real network
# event on a real SSID, so the collected marker below should still refresh;
# it is only the ADDRESS that must not be believed.
#
# Same rejection the two QR producers already apply before encoding a URL,
# kept in the same order: src/literary_clock.py (_resolve_lan_ip) and
# src/control_server/handoff.py.
# litclock-dev#667: keep the OBSERVED address before blanking. Coalescing and recording
# answer two different questions and must not share one variable:
#
#   "have I already acted on this exact address?"  -> the observed value
#   "what address should diagnostics believe?"     -> the blanked value
#
# Collapsing them is what broke: the same-IP short-circuit below is gated on
# `[ -n "$CURRENT_IP" ]`, so a blanked link-local failed the gate, never
# reached `exit 0`, and fell through to a full e-ink render. Every single
# dhcp4-change on a clock with broken DHCP repainted the panel — measured
# three renders for three identical events where a real address produces one.
# That is exactly the unbounded-render / SPI-contention failure the litclock-dev#309
# /review A4 guard below exists to prevent, and litclock-dev#645 reintroduced it by
# adding the blanking without extending the short-circuit to cover it.
RAW_IP="${CURRENT_IP:-}"
case "${CURRENT_IP:-}" in
    169.254.*|127.*) CURRENT_IP="" ;;
esac

# Record "network data has been collected on this Pi" in the persistent
# marker (litclock-dev#445) BEFORE the same-IP short-circuit below — reaching here means
# wlan0 is up with networking, which is exactly what the /diagnostics Network
# section reports, so even an unchanged-IP lease renewal should refresh the
# marker. This is what makes the grey "Not yet collected" tier stop flashing
# for ~5-10s after every reboot (the marker survives reboot; the old
# /run/litclock check did not). Best-effort: the helper always exits 0.
#
# Also BEFORE the .handoff-complete gate further down (litclock-dev#645). The grey
# "Not yet collected" tier is the fallback that would otherwise have muted the
# false anomaly, but _anomalies.py requires an empty SSID to mute — and on
# this path SSID is populated while this marker is missing, so the section
# rendered as a fault instead. Collecting network data is inert; gating it
# bought nothing and cost the mute.
#
# The `|| true` is load-bearing, not decoration: under `set -e` a helper that
# exits non-zero would abort the script HERE, before the marker write below —
# litclock-dev#645's exact shape, one token away. tests/test_nm_dispatcher_behavior.py
# pins both the failing helper and the missing one.
#
# litclock-dev#387 C1: this dispatcher runs as ROOT, so it invokes the ROOT-OWNED copy at
# /usr/local/lib/litclock — NOT /home/pi/litclock/scripts (pi-writable, which
# would be a pi→root escalation on the next DHCP event once 010_pi-nopasswd is
# dropped). Deliberately NO fallback to the repo copy: running the pi-writable
# script as root is the exact escalation this closes. A missing installed copy
# just skips the marker refresh, which the /diagnostics read side tolerates via
# its legacy tmpfs check.
if [ -x /usr/local/lib/litclock/litclock-mark-collected.sh ]; then
    /usr/local/lib/litclock/litclock-mark-collected.sh network 2>/dev/null || true
fi

# Same-IP short-circuit (litclock-dev#309 /review adversarial finding A4): NM fires
# `dhcp4-change` on every DHCP lease renewal — including renewals that
# keep the same IP. Without this guard, a 12-hour lease would gratuitously
# re-render the e-ink at every renewal, and a flapping AP that emits
# periodic dhcp4-change events could queue unbounded litclock.service
# starts (each render holds the SPI bus, blocking the legitimate
# minute-tick render and burning panel cycles). Marker lives on tmpfs;
# tmpfiles.d/litclock.conf creates /run/litclock at every boot, so the
# `mkdir -p` below is defensive only.
#
# The filename says "rendered" for historical reasons and is load-bearing on
# the read side (control_server._network and routes/diagnostics/_collectors.py
# each hardcode it, and the LITCLOCK_DIAG_LAST_IP_PATH override names it).
# Since litclock-dev#645 it means "last address RECORDED" — pre-handoff it is written
# with no render following.
# litclock-dev#667 — one creator for /run/litclock, used by both marker writes below.
#
# tmpfiles.d/litclock.conf declares this dir 0755 pi pi at sysinit, so this is
# defensive only — but this script runs as ROOT and since litclock-dev#645 moved the
# handoff gate it runs EARLIER in boot, so on any boot where the dir is
# genuinely absent a bare `mkdir` would create it root:root and every pi-side
# writer would fail silently for the rest of that boot: the current-quote file
# and LKG heartbeat in literary_clock.py, update_state, the weather cache, and
# the gift-message write in routes/system.py.
#
# The ownership attempt comes FIRST and the fallbacks exist because
# `install -d -o pi -g pi` fails WHOLESALE if the `pi` user does not exist (a
# renamed user, or the DIY path), where the `mkdir -p` it replaced would still
# have created the directory. A missing user must cost the ownership, not the
# directory.
ensure_run_dir() {
    install -d -o pi -g pi -m 0755 /run/litclock 2>/dev/null ||
        install -d -m 0755 /run/litclock 2>/dev/null ||
        mkdir -p /run/litclock 2>/dev/null || true
}

MARKER=/run/litclock/last-rendered-ip
# litclock-dev#387 C2: this dispatcher runs as ROOT and /run/litclock is 0755 pi pi, so a
# pi-planted symlink at $MARKER would make the read/write below touch an
# arbitrary file as root. Refuse to follow a symlink — drop it and treat as
# "no previous IP" (a fresh regular file is written below). The residual TOCTOU
# (replant between this drop and the write) needs a pi shell, which post-010 is
# confined to the scoped sudoers commands.
if [ -L "$MARKER" ]; then
    rm -f "$MARKER" 2>/dev/null || true
fi
LAST_IP=""
if [ -f "$MARKER" ] && [ ! -L "$MARKER" ]; then
    # Bounded, whitespace-stripped read (litclock-dev#645 /review). $MARKER lives in a
    # pi-writable directory but is read and re-emitted by ROOT below, so its
    # CONTENT is untrusted even though the symlink guards prove the node is a
    # regular file. Unbounded, an oversized value makes the `logger` execve
    # fail E2BIG and `set -e` abort the script before the render; unstripped,
    # an embedded newline forges a standalone dispatcher line in journald —
    # the evidence channel this script exists to feed. Same shape as
    # scripts/shutdown-splash.sh's root read of /run/litclock/shutdown-action.
    # litclock-dev#667: read LAST_IP UNCONDITIONALLY (it used to be gated on a non-empty
    # CURRENT_IP), so the log lines below can tell the truth on a blanked event.
    # Previously a link-local printed "IP changed to unknown (was: none)" while
    # the marker still held the real prior address — asserting a change that did
    # not happen and reporting "none" for a value that exists. That is the same
    # wrong-conclusion class litclock-dev#646 was opened to kill.
    LAST_IP=$(head -c 64 "$MARKER" 2>/dev/null | tr -d '[:space:]' || true)
fi

# litclock-dev#667 — the coalescing marker, deliberately separate from $MARKER.
# $MARKER holds the last BELIEVABLE address and is read by
# control_server._network.read_lan_ip to serve the /diagnostics Network
# section, so a link-local must never land in it (litclock-dev#645: _anomalies only
# tests lan_ip for truthiness, so recording one would mute the missing-IP
# fault forever). This file holds the last address we ACTED on, believable or
# not, and nothing outside this script reads it. Same tmpfs, same symlink
# discipline, same bounded read.
OBSERVED_MARKER=/run/litclock/last-observed-ip
if [ -L "$OBSERVED_MARKER" ]; then
    rm -f "$OBSERVED_MARKER" 2>/dev/null || true
fi
OBSERVED_SEEN=0
LAST_OBSERVED=""
if [ -f "$OBSERVED_MARKER" ] && [ ! -L "$OBSERVED_MARKER" ]; then
    OBSERVED_SEEN=1
    LAST_OBSERVED=$(head -c 64 "$OBSERVED_MARKER" 2>/dev/null | tr -d '[:space:]' || true)
elif [ -n "${CURRENT_IP:-}" ]; then
    # Seed from $MARKER when the observed marker is absent, so an OTA update
    # landing between two events on a still-running device does not lose one
    # renewal's worth of coalescing.
    #
    # ONLY when the current address is believable, though. $MARKER holds the
    # last BELIEVABLE address, which during a link-local or no-address outage
    # is a stale routable address the interface no longer carries — seeding
    # from it there would assert "I already acted on <stale IP>" when the last
    # thing actually acted on was the outage, and the recovery repaint would be
    # swallowed. A spurious render on the first post-OTA event is strictly
    # cheaper than a swallowed recovery.
    OBSERVED_SEEN=1
    LAST_OBSERVED="$LAST_IP"
fi
# Short-circuit on the OBSERVED address, so a repeated link-local — or a
# repeated no-address-at-all — coalesces the same way a repeated real address
# does. Gated on OBSERVED_SEEN rather than on RAW_IP being non-empty, because
# "no IPv4 at all" is a legitimate observed value that must coalesce too:
# NM's default `ipv4.method=auto` FAILS IPv4 on a DHCP timeout rather than
# self-assigning 169.254.x (nothing here sets `ipv4.link-local`), so the empty
# case is at least as likely as the link-local one.
#
# The second clause restores litclock-dev#645's self-heal. This exit now sits ABOVE the
# $MARKER write, so skipping it must not leave that file stale or absent —
# otherwise a plain (non-symlink) file planted at $OBSERVED_MARKER in the
# pi-writable /run/litclock could suppress the diagnostics write for the life
# of the boot and resurrect litclock-dev#645's false "Connection issue" with every litclock-dev#387
# C2 symlink guard intact. Requiring $MARKER to already agree means we only
# skip work that is genuinely already done.
if [ "$OBSERVED_SEEN" = 1 ] && [ "$RAW_IP" = "$LAST_OBSERVED" ] &&
    { [ -z "${CURRENT_IP:-}" ] || [ "$CURRENT_IP" = "$LAST_IP" ]; }; then
    # Same address as last time and the bookkeeping already agrees — nothing to
    # repaint, in either handoff state, believable or not. NM fires `up` and
    # `dhcp4-change` back to back and the second lands here, so this is the
    # common path.
    exit 0
fi
# Record what we observed BEFORE any early exit below, so the next event can
# coalesce against it even on paths that record no believable address and
# render nothing (the pre-handoff gate, every link-local event, and every
# no-address event). Written UNCONDITIONALLY — an empty value is a real
# observation, and skipping the write for it is what left the empty case
# uncoalesced.
ensure_run_dir
if [ -L "$OBSERVED_MARKER" ]; then
    rm -f "$OBSERVED_MARKER" 2>/dev/null || true
fi
printf '%s\n' "$RAW_IP" > "$OBSERVED_MARKER" 2>/dev/null || true

# Record the current IP. Unconditional bookkeeping since litclock-dev#645:
# control_server._network.read_lan_ip serves the /diagnostics Network section
# straight from this file, so it must be written on every qualifying event
# including the pre-handoff `up`, where no render follows at all. It also
# still coalesces a rapid follow-up event (e.g. `up` immediately followed by
# `dhcp4-change`) once the gate below is open.
if [ -n "${CURRENT_IP:-}" ]; then
    # `install -d` with the ownership spelled out, not `mkdir -p` (litclock-dev#645
    # /review). tmpfiles.d/litclock.conf declares this dir 0755 pi pi at
    # sysinit, so this is defensive only — but this script runs as ROOT, and
    # since the gate moved it runs EARLIER in boot, so on any boot where the
    # dir is genuinely absent a bare mkdir would create it root:root and every
    # pi-side writer would fail silently for the rest of that boot: the
    # current-quote file and LKG heartbeat in literary_clock.py, update_state,
    # the weather cache, and the gift-message write in routes/system.py.
    ensure_run_dir
    # Re-drop a symlink immediately before the redirect (best-effort vs a
    # persistent-symlink attack; see the C2 note above).
    if [ -L "$MARKER" ]; then
        rm -f "$MARKER" 2>/dev/null || true
    fi
    printf '%s\n' "$CURRENT_IP" > "$MARKER" 2>/dev/null || true
fi

# Skip the RE-RENDER until the first-boot handoff is done. Without this gate,
# every hotspot teardown during initial setup would queue a litclock.service
# start before the service is ready to render real quotes.
#
# litclock-dev#645: this gate used to sit at the top of the script, before the two
# bookkeeping writes above. The ordering on a fresh provision is fixed —
# wlan0's `up` onto the user's SSID fires BEFORE .handoff-complete is
# written — so the one event that would have recorded the new address was
# always the one skipped, and /run/litclock/last-rendered-ip stayed absent
# until the next DHCP renewal (observed lease: 7200s). The diagnostics Network
# section reads lan_ip from that marker, so every freshly provisioned clock
# showed a false "Connection issue" for up to an hour, past the 300s
# ANOMALY_LAN_IP_SETTLE_S grace. Recording the current IP is inert; only the
# render needs suppressing, so only the render is gated.
if [ ! -f /etc/litclock/.handoff-complete ]; then
    # Pre-handoff, so there is nothing to repaint yet — but say so, rather
    # than exiting silently. This is the window litclock-dev#645 hid in. The message
    # branches on whether anything was actually written: claiming a write the
    # `[ -n "$CURRENT_IP" ]` guard above skipped would be the same defect as
    # the handoff timer in litclock-dev#646.
    if [ -n "${CURRENT_IP:-}" ]; then
        logger -t litclock-dispatcher \
            "wlan0 IP recorded as ${CURRENT_IP} (was: ${LAST_IP:-none}); handoff not complete — not rendering" \
            || true
    else
        logger -t litclock-dispatcher \
            "wlan0 up with no IPv4 address yet; nothing recorded, handoff not complete — not rendering" \
            || true
    fi
    exit 0
fi

# Log one line per real IP change so an operator debugging a stale-QR
# report has journalctl evidence the dispatcher fired. Volume is tiny
# (most days: zero entries thanks to the same-IP short-circuit above).
# `|| true` so a logging hiccup can never abort the script under `set -e`
# and swallow the render below.
# litclock-dev#667: branch on what actually happened. The single-form version claimed
# "IP changed to unknown (was: none)" on a blanked event while the marker still
# held the real prior address — two falsehoods in the one line an operator has
# to reason from, on a device where journald is the only diagnostic channel.
if [ -n "${CURRENT_IP:-}" ]; then
    logger -t litclock-dispatcher \
        "wlan0 IP changed to ${CURRENT_IP} (was: ${LAST_IP:-none}); re-rendering" \
        || true
else
    logger -t litclock-dispatcher \
        "wlan0 has no routable IPv4 address (DHCP appears to have failed; last recorded: ${LAST_IP:-none}); nothing recorded, re-rendering" \
        || true
fi

# --no-block: NM dispatcher scripts MUST return promptly (NM logs slow
# scripts as warnings, may kill long-runners). Best-effort: if systemctl
# is unavailable for any reason, swallow the error so we never bubble
# a non-zero exit up to NM. The next minute-boundary tick of
# litclock.timer will render with the current IP regardless.
systemctl start --no-block litclock.service 2>/dev/null || true
