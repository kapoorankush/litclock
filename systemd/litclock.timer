[Unit]
Description=LitClock Minute Timer
Documentation=https://github.com/kapoorankush/litclock
After=sysinit.target

[Timer]
# litclock-dev#762 — fire ~4s EARLY and render the upcoming minute, so the
# panel's ~2.4s trigger-to-legible blackout falls at the boundary rather than
# after it. Paired with RENDER_LEAD_S in src/literary_clock.py: this line
# WITHOUT that offset renders the previous minute's quote permanently.
#
# litclock-dev#980 — the UTC suffix is load-bearing. A bare spec is evaluated
# in LOCAL time, and at the DST fall-back systemd steps from the 01:59:56 run
# straight to 02:00:56 in the NEW offset: the repeated hour gets no ticks and
# the panel sits on "1:00" for 61 minutes (both Pis, 2026-11-01). Every zone's
# offset is a whole number of minutes, so second :56 UTC is second :56 local
# and the fire times are otherwise unchanged. Needs systemd >= 235.
OnCalendar=*-*-* *:*:56 UTC
AccuracySec=1s

[Install]
WantedBy=timers.target
