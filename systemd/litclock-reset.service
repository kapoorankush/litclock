[Unit]
Description=LitClock — Factory reset (wipe config + WiFi, power off)
Documentation=https://github.com/kapoorankush/litclock/issues/510
# Bidirectional interlock with the weekly/PWA updater: if an update fires mid-
# reset, systemd SIGTERMs the reset script and leaves the device half-wiped with
# no power-off. The route also pre-checks update_is_busy() for a friendly 409, but
# Conflicts= is the deterministic backstop (mirrors litclock-wifi-reset.service).
Conflicts=litclock-update.service
After=litclock-update.service

[Service]
Type=oneshot
User=root
# Runs the ROOT-OWNED copy (installed alongside the gift unit's copy, litclock-dev#387 C1) —
# not /home/pi/... — so a pi-writable path can't be swapped under the power-off.
# --wipe-wifi --poweroff --yes: full wipe of config + WiFi, then POWER OFF
# (litclock-dev#627). After a full wipe the next power-on runs first-boot into
# the setup hotspot regardless, so powering off — not rebooting into a live
# hotspot — is the right end state for a mover packing the clock up or handing
# it on. NOT --gift-mode (that adds a welcome splash, which is gift-only; a
# factory reset gets the plain "Powered Off" screen). See litclock-dev#510 + litclock-dev#627.
# --strict-env-wipe (litclock-dev#510 review): if the config wipe fails, abort BEFORE the
# WiFi wipe + power-off so a factory reset never silently powers off from a
# stale-config state — leaves WiFi up so the PWA can report the failure + retry.
ExecStart=/usr/local/lib/litclock/reset-setup.sh --wipe-wifi --strict-env-wipe --poweroff --yes
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
